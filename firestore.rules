rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    // Replace 'your-admin-email@example.com' with your actual admin email
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email != null;
    }
    
    // Feedbacks collection rules
    match /feedbacks/{feedbackId} {
      
      // Allow public read access only for approved feedbacks
      allow read: if resource.data.status == 'approved';
      
      // Allow public write access for creating new feedbacks with status 'pending'
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.clientName is string
                    && request.resource.data.projectTitle is string
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.startDate is string
                    && request.resource.data.endDate is string
                    && request.resource.data.feedback is string
                    && request.resource.data.feedback.size() >= 20
                    && request.resource.data.submittedAt is timestamp
                    && request.resource.data.approvedAt == null
                    && request.resource.data.approvedBy == null;
      
      // Admin can read all feedbacks
      allow read: if isAdmin();
      
      // Admin can update feedback status (approve)
      allow update: if isAdmin()
                    && request.resource.data.status in ['approved', 'rejected'];
      
      // Admin can delete any feedback
      allow delete: if isAdmin();
      
      // Admin can create pre-approved feedbacks
      allow create: if isAdmin()
                    && request.resource.data.status == 'approved';
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
