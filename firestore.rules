rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    // Add your admin email(s) here
    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email in [
               // Add your admin email(s) here
               // Example: 'admin@example.com',
             ];
    }
    
    // Feedbacks collection
    match /feedbacks/{feedbackId} {
      // Public can create feedbacks (form submissions)
      allow create: if true;
      
      // Anyone can read approved feedbacks
      // (queries MUST include where('status', '==', 'approved') to satisfy this rule)
      allow read: if resource.data.status == 'approved';
      
      // Admins can read all feedbacks (including pending/rejected), update, and delete
      allow read, update, delete: if isAdmin();
    }
    
    // Projects collection
    match /projects/{projectId} {
      // Anyone can read published projects
      allow read: if resource.data.status == 'published' || isAdmin();
      
      // Only admins can create, update, or delete projects
      allow create, update, delete: if isAdmin();
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
